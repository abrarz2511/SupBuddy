# Database
DATABASE_URL=postgresql+asyncpg://supbuddy:password@localhost:5432/supbuddy
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# API
API_V1_PREFIX=/api/v1
API_TITLE=SupBuddy Logistics API
API_VERSION=1.0.0
API_DESCRIPTION=Logistics shipment tracking system with SLA monitoring and AI-powered exception analysis
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Scheduler
SCHEDULER_ENABLED=true
TRACKING_PULL_INTERVAL_MINUTES=5
SLA_EVAL_INTERVAL_MINUTES=10

# Agent
WATSONX_API_URL=https://your-watsonx-instance-url
WATSONX_API_KEY=your_watsonx_api_key_here
AGENT_TIMEOUT_SECONDS=30

# Context Collection
CONTEXT_COLLECTION_TIMEOUT=20
CONTEXT_TOOL_TIMEOUT=10
CONTEXT_RETRY_ENABLED=true
CONTEXT_MAX_RETRIES=1
CONTEXT_PARALLEL_EXECUTION=true

# External APIs (Mock for now)
WEATHER_API_KEY=mock
TRAFFIC_API_KEY=your_traffic_api_key_here
PORT_API_KEY=mock
NEWS_API_KEY=mock

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security (generate secure keys for production)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
